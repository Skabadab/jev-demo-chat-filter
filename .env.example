# Copy to .env and fill in your key: cp .env.example .env
OPENROUTER_API_KEY=your-openrouter-api-key
# Jev on OpenRouter (use ~typesafe/jev-latest to always get the newest Jev)
OPENROUTER_MODEL=typesafe/jev-1.13

# "Normal" LLMs for the second switch (comma separated OpenRouter model ids, first is the default).
# Append @low / @medium / @high to set the reasoning effort for a model,
# or @default to use a reasoning model at its own default effort.
OPENROUTER_LLM_MODELS=anthropic/claude-haiku-4.5,openai/gpt-6-luna,anthropic/claude-sonnet-5.5@low,anthropic/claude-sonnet-5.5@high,anthropic/claude-opus-5.5@low,anthropic/claude-opus-5.5@high,openai/gpt-5.6-terra@low,openai/gpt-5.6-terra@high,openai/gpt-6.1-sol@low,openai/gpt-6.1-sol@high,anthropic/claude-fable-5.1@default,openai/gpt-6-astra@default

# Optional
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
# JEV_BATCH_SIZE=100
# JEV_CONCURRENCY=8
# PORT=3000
